# WasteChain Frontend Environment Variables

# Centralized Express Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Standalone development fallback toggle
# Set to 'true' to use local mock adapter when backend is offline
# Set to 'false' to route 100% of requests strictly to your Express / Supabase backend
VITE_USE_MOCK_API=true
